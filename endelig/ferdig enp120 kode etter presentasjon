        "Sommar": (f"{yr}-07-01", 31),   # Juli
        "Haust":  (f"{yr}-10-01", 31),   # Oktober
    }

    for season, (date_str, n_days) in seasons.items():
        start = pd.Timestamp(date_str)
        t, ld, w, s, bd, chg, cur, dfc, soc = _get_period_data(
