def fetch_era5_weather():
    """Fetch ERA5 hourly wind/solar/temp from Open-Meteo; cache locally."""
    if os.path.exists(WEATHER_CACHE):
        print("  ✓ Weather cache found — loading...")
        with open(WEATHER_CACHE) as f:
            raw = json.load(f)
    else:
        url = (
            f"https://archive-api.open-meteo.com/v1/era5"
            f"?latitude={UTSIRA_LAT}&longitude={UTSIRA_LON}"
            f"&start_date={WEATHER_YEAR}-01-01&end_date={WEATHER_YEAR}-12-31"
            "&hourly=wind_speed_10m,wind_speed_100m,shortwave_radiation,temperature_2m"
            "&wind_speed_unit=ms"
        )
        print(f"  ↓ Fetching ERA5 from Open-Meteo for Utsira ({UTSIRA_LAT}°N)...")
        raw = requests.get(url, timeout=30).json()
        with open(WEATHER_CACHE, "w") as f:
            json.dump(raw, f)
