def get_battery_specs():
    """Return total battery capacity (MWh) and max power (kW) from Megapack config."""
    capacity_MWh = N_MEGAPACKS * MEGAPACK_CAPACITY_MWh
    power_kW     = N_MEGAPACKS * MEGAPACK_POWER_MW * 1000
    print(f"  ✓ Battery: {N_MEGAPACKS}× Tesla Megapack 2XL "
          f"= {capacity_MWh:.1f} MWh  |  {power_kW/1000:.1f} MW")
    return capacity_MWh, power_kW


def simulate_battery(net_kW, capacity_MWh, max_power_kW,
                     initial_soc=0.5, efficiency=0.92, min_soc=None):
    """
    Hourly battery dispatch with power limit (MW), energy limit (MWh),
    and a hard minimum SoC floor (default: MIN_BATTERY_SOC from config).

    Energy below the floor is unavailable — demand that cannot be met
    is counted as deficit (unmet load).

    Returns soc_MWh, curtailed_kW, deficit_kW.
    """
    if min_soc is None:
        min_soc = MIN_BATTERY_SOC

    cap         = capacity_MWh * 1000          # kWh
    floor_kWh   = min_soc * cap                # hard minimum kWh
    soc         = initial_soc * cap
    soc_arr     = np.zeros(len(net_kW))
    curt        = np.zeros(len(net_kW))
    deficit     = np.zeros(len(net_kW))

    for i, p in enumerate(net_kW):
        if p >= 0:
            # Charge — limited by power AND remaining headroom above floor
            charge   = min(p * efficiency, cap - soc, max_power_kW * efficiency)
            soc     += charge
            curt[i]  = p - charge / efficiency
        else:
            # Discharge — only energy ABOVE the floor is available
            available   = max(0.0, (soc - floor_kWh) * efficiency)
            discharge   = min(-p, available, max_power_kW)
            soc        -= discharge / efficiency
            deficit[i]  = max(0.0, -p - discharge)

        soc_arr[i] = soc

    return soc_arr / 1000, curt, deficit


def simulate_dunkelflaute_48h(demand_kW, battery_MWh, max_power_kW,
                               initial_soc=1.0, efficiency=0.92):
    """
    Simuler 48 timar med null vind og sol — berre batteri leverer straum.
    Startar med fullt batteri (100 % SoC).
    Energi under MIN_BATTERY_SOC (10 %) er ikkje tilgjengeleg — same grense
    som i hovudsimuleringa.
    Returnerer soc_pct, discharge_kW, deficit_kW, demand_arr.
    """
    hours     = 48
    cap_kWh   = battery_MWh * 1000
    floor_kWh = MIN_BATTERY_SOC * cap_kWh     # same 10 % floor som resten
    soc_kWh   = initial_soc * cap_kWh

    soc_pct   = np.zeros(hours + 1)
    discharge = np.zeros(hours)
    deficit   = np.zeros(hours)

    soc_pct[0] = 100.0

    # Bruk faktisk gjennomsnittsforbruk per time over heile året
    demand = np.asarray(demand_kW)[:hours].astype(float)

    for i in range(hours):
        needed    = demand[i]
        available = max(0.0, (soc_kWh - floor_kWh) * efficiency)
        can_out   = min(needed, available, max_power_kW)
        soc_kWh  -= can_out / efficiency
        soc_kWh   = max(floor_kWh, soc_kWh)   # hald SoC over golvet

        discharge[i] = can_out
        deficit[i]   = max(0.0, needed - can_out)
        soc_pct[i+1] = 100.0 * soc_kWh / cap_kWh

    return soc_pct, discharge, deficit, demand


