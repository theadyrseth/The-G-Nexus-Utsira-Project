def build_salmon_load(dti):
    """Flat weekday plant load, rescaled to annual target."""
    annual_kWh = SALMON_TONS_PER_YEAR * SALMON_SEC_kWh_PER_TON
    avg_op_kW = annual_kWh / SALMON_OPERATING_HOURS
    operating = (
        (np.array(dti.hour) >= 6)
        & (np.array(dti.hour) < 18)
        & (np.array(dti.dayofweek) < 5)
    ).astype(float)
    seasonal = np.where(
        (np.array(dti.month) >= 10) | (np.array(dti.month) <= 1), 1.3, 1.0
    )
    raw = operating * avg_op_kW * seasonal
    if raw.sum() > 0:
        raw *= annual_kWh / raw.sum()
    return raw


def build_water_sanitation_load(dti):
    """Near-constant water/sanitation load with small daytime boost."""
    diurnal = 0.9 + 0.1 * np.clip(np.sin(np.pi * (np.array(dti.hour) - 6) / 12), 0, 1)
    return pd.Series(WATER_SANITATION_kW * diurnal, index=dti)


def build_ev_load(dti):
    """Evening EV charging spike."""
    peak_kW = N_CHARGING_POINTS * EV_CHARGER_kW * EV_SIMULTANEOUS_FACTOR
    in_window = (
        (np.array(dti.hour) >= EV_EVENING_START_HOUR)
        & (np.array(dti.hour) < EV_EVENING_END_HOUR)
    ).astype(float)
    weekday = np.where(np.array(dti.dayofweek) < 5, 1.0, 0.7)
    return pd.Series(peak_kW * in_window * weekday, index=dti)



def load_data_center(dti):
    """Load DC CSV (30-min) and resample to hourly. Falls back to flat 1 MW."""
    if os.path.exists(DATA_CENTER_CSV):
        df = pd.read_csv(DATA_CENTER_CSV, parse_dates=["timestamp"])
        df = df.sort_values("timestamp").set_index("timestamp")
        df["total_kw"] = df["it_electrical_load_kw"] + df["cooling_thermal_load_kw"]
        vals = df["total_kw"].resample("h").mean().values[:N_HOURS].astype(float)
        if len(vals) < N_HOURS:
            vals = np.pad(vals, (0, N_HOURS - len(vals)), constant_values=vals[-1])
        print(f"  ✓ DC CSV loaded. Mean load: {vals.mean():.1f} kW")
        return pd.Series(vals, index=dti)

    print("  ⚠ DC CSV not found — using flat 1 MW placeholder.")
    return pd.Series(1000.0, index=dti)


