def plot_pareto_frontier(demand_kW, weather_df, dti):
    """
    Køyr simuleringa for mange kombinasjonar av vindmøller og Megapack-einingar.
    Plottar Pareto-frontier: Curtailment [GWh] vs Unmet demand [%].
    """
    print("  ↓ Køyrer Pareto-analyse (dette tek litt tid)...")

    turbine_options  = [1, 2, 3, 4]
    megapack_options = [2, 4, 6, 8, 10, 14]

    # Fargar per antal turbinar
    colors = {1: "#90caf9", 2: "#1565c0", 3: "#0d47a1", 4: "#01579b"}
    markers = {2: "o", 4: "s", 6: "^", 8: "D", 10: "P", 14: "*"}

    fig, ax = plt.subplots(figsize=(11, 7))

    best_point = None
    best_served = -1

    for n_turb in turbine_options:
        # Rekn ut vindproduksjon for dette antal turbinar
        scale = n_turb / N_WIND_TURBINES
        wind_kW_scaled = wind_power_curve(weather_df["wind_100m"].values) * (n_turb / N_WIND_TURBINES) * (N_WIND_TURBINES)
        # Bruk effektkurva direkte med riktig antal turbinar
        vestas_kW = np.array(VESTAS_V90_KW)
        wind_kW_n = np.clip(
            np.interp(weather_df["wind_100m"].values, VESTAS_V90_MS, vestas_kW * n_turb),
            0, n_turb * TURBINE_RATED_MW * 1000
        )
        solar_kW_arr = pv_power(weather_df["irradiance"].values, weather_df["temp_2m"].values)
        supply = wind_kW_n + solar_kW_arr

        for n_mp in megapack_options:
            cap_MWh  = n_mp * MEGAPACK_CAPACITY_MWh
            pow_kW   = n_mp * MEGAPACK_POWER_MW * 1000
            net      = supply - demand_kW.values
            _, curt, deficit = simulate_battery(net, cap_MWh, pow_kW)

            total_demand  = demand_kW.values.sum()
            unmet_pct     = 100 * deficit.sum() / total_demand
            curt_GWh      = curt.sum() / 1e6
            served_pct    = 100 - unmet_pct

            label = f"{n_turb} turbin{'ar' if n_turb>1 else ''}"
            sc = ax.scatter(
                curt_GWh, unmet_pct,
                color=colors[n_turb],
                marker=markers[n_mp],
                s=120 + n_mp * 8,
                alpha=0.85,
                zorder=5,
            )

            # Annotér Megapack-tal
            ax.annotate(
                f"{n_mp}×MP",
                (curt_GWh, unmet_pct),
                textcoords="offset points",
                xytext=(6, 4),
                fontsize=6.5,
                color=colors[n_turb],
            )

            if served_pct > best_served:
                best_served = served_pct
                best_point  = (curt_GWh, unmet_pct, served_pct)

    # Markér beste punkt
    if best_point:
        ax.annotate(
            f"Best\n{best_point[2]:.1f}% served",
            (best_point[0], best_point[1]),
            xytext=(15, -25), textcoords="offset points",
            fontsize=8, color="green", fontweight="bold",
            bbox=dict(boxstyle="round,pad=0.3", facecolor="#e8f5e9", alpha=0.9),
            arrowprops=dict(arrowstyle="->", color="green"),
        )

    # Legg til 1%-linje for unmet demand
    ax.axhline(1, color="red", ls="--", lw=1, label="1% unmet (mål)", zorder=3)
    ax.fill_between(ax.get_xlim(), 0, 1, color="green", alpha=0.07)

    # Legende for turbinar
    from matplotlib.lines import Line2D
    turb_handles = [
        Line2D([0], [0], marker="o", color="w", markerfacecolor=colors[n],
               markersize=10, label=f"{n} vindmølle{'r' if n>1 else ''} ({n*TURBINE_RATED_MW:.0f} MW)")
        for n in turbine_options
    ]
    mp_handles = [
        Line2D([0], [0], marker=markers[n], color="grey",
               markersize=8, label=f"{n}× Megapack ({n*MEGAPACK_CAPACITY_MWh:.0f} MWh)")
        for n in megapack_options
    ]
    ax.legend(handles=turb_handles + mp_handles, fontsize=7.5,
              loc="upper right", ncol=2, framealpha=0.85)

    ax.set_xlabel("Total curtailment [GWh]", fontsize=11)
    ax.set_ylabel("Unmet demand [%]", fontsize=11)
    ax.set_title(
        "Efficiency Frontier: Curtailment vs. Unmet Demand\n"
        "(ideelt punkt = nedre venstre hjørne)",
        fontsize=11
    )
    ax.set_ylim(bottom=0)
    ax.set_xlim(left=0)
    ax.grid(alpha=0.3)

    plt.tight_layout()
    plt.savefig("plots/fig_pareto_frontier.png", dpi=150)
    plt.close()
    print("  ✓ Saved plots/fig_pareto_frontier.png")


def plot_generation_profiles(dti, wind_kW, solar_kW):
    """Wind and solar generation profiles side by side."""
    wind_d  = pd.Series(np.asarray(wind_kW) / 1000, index=dti).resample("D").mean()
    solar_d = pd.Series(np.asarray(solar_kW) / 1000, index=dti).resample("D").sum() * 24

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 5))
    ax1.bar(wind_d.index,  wind_d,  color=C["wind"],  alpha=0.7, width=1)
    ax1.set_ylabel("Power (MW)")
    ax1.set_title(f"Wind — {WIND_INSTALLED_MW} MW")

    ax2.bar(solar_d.index, solar_d, color=C["solar"], alpha=0.8, width=1)
    ax2.set_ylabel("Daily Energy (MWh)")
    ax2.set_title(f"Solar PV — {SOLAR_INSTALLED_MW*1000:.0f} kWp")

    fig.autofmt_xdate()
    plt.tight_layout()
    plt.savefig("plots/fig11_generation_profiles.png", dpi=150)
    plt.close()
    print("  ✓ Saved plots/fig11_generation_profiles.png")


