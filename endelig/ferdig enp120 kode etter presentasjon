def _detect_column_map(header_line, sep):
    """
    Map raw column names (Norwegian or English) to internal names.
    Returns dict: internal_name -> original_name, or None if required cols missing.
    """
    cols = {c.strip().upper(): c.strip() for c in header_line.split(sep)}

    start_col = (
        cols.get("START_TID")
        or cols.get("STARTTID")
        or cols.get("START_TIME")
        or cols.get("STARTTIME")
    )
    knr_col = (
        cols.get("KOMMUNENUMMER")
        or cols.get("MUNICIPALITYNUMBER")
        or cols.get("MUNICIPALITY_NO")
        or cols.get("MUNICIPALITY_NUMBER")
    )
    grp_col = (
        cols.get("FORBRUKSGRUPPE")
        or cols.get("CONSUMPTION_GROUP")
        or cols.get("CONSUMPTIONGROUP")
        or cols.get("CONSUMERGROUP")
        or cols.get("CONSUMER_GROUP")
    )
    vol_col = (
        cols.get("VOLUM_KWH")
        or cols.get("VOLUME_KWH")
        or cols.get("CONSUMPTION_KWH")
        or cols.get("QUANTITY")
    )

    if not all([start_col, knr_col, grp_col, vol_col]):
        print(f"  ⚠ Klarte ikke å identifisere alle nødvendige kolonner.")
        print(f"    Kolonner i headeren: {list(cols.values())}")
        print(f"    start={start_col}, knr={knr_col}, grp={grp_col}, vol={vol_col}")
        return None

    return {
        "startTime": start_col,
        "municipalityNo": knr_col,
        "consumerGroup": grp_col,
        "consumption_kWh": vol_col,
    }


def _filter_chunk(chunk_df, col_map):
    """Rename columns, filter for Utsira + SIM_YEAR, return filtered DataFrame."""
    rename = {v: k for k, v in col_map.items()}
    chunk_df = chunk_df.rename(columns=rename)

    chunk_df["municipalityNo"] = chunk_df["municipalityNo"].astype(str).str.strip().str.zfill(4)
    # utc=True handles mixed CET/CEST timestamps; tz_convert(None) strips tz for naive index
    chunk_df["startTime"] = (
        pd.to_datetime(chunk_df["startTime"], errors="coerce", utc=True)
        .dt.tz_convert(None)
    )
    chunk_df["consumption_kWh"] = pd.to_numeric(chunk_df["consumption_kWh"], errors="coerce")

    mask = (
        (chunk_df["municipalityNo"] == UTSIRA_MUNICIPALITY_CODE.zfill(4))
        & (chunk_df["startTime"].dt.year == SIM_YEAR)
    )
    return chunk_df.loc[mask, ["startTime", "municipalityNo", "consumerGroup", "consumption_kWh"]].copy()


def _stream_elhub(verify_ssl=True, chunk_lines=50_000):
    """
    Stream the Elhub CSV line by line. Never loads the full file into memory.
    Yields filtered DataFrames for Utsira / SIM_YEAR only.
    """
    headers = {
        "User-Agent": "Mozilla/5.0 (compatible; ENP120-simulation/1.0)",
        "Accept": "text/csv,application/csv,text/plain,*/*",
    }

    if not verify_ssl:
        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

    with requests.get(
        ELHUB_CSV_URL,
        headers=headers,
        stream=True,
        timeout=300,
        verify=verify_ssl,
    ) as resp:
        resp.raise_for_status()

        header_line = None
        sep = ","
        col_map = None
        buffer = []
        rows_read = 0
        rows_matched = 0

        for raw_line in resp.iter_lines(decode_unicode=True):
            if raw_line is None:
                continue
            line = raw_line.strip()
            if not line:
                continue

            # First non-empty line is the header
            if header_line is None:
                header_line = line
                sep = ";" if line.count(";") > line.count(",") else ","
                print(f"  ℹ Skilletegn: '{sep}'  |  Header: {line[:120]}...")
                col_map = _detect_column_map(header_line, sep)
                if col_map is None:
                    raise ValueError("Fant ikke nødvendige kolonner i Elhub-filen.")
                buffer = [header_line]
                continue

            buffer.append(line)
            rows_read += 1

            if len(buffer) >= chunk_lines + 1:  # +1 for header
                text = "\n".join(buffer)
                try:
                    df_chunk = pd.read_csv(io.StringIO(text), sep=sep, dtype=str, low_memory=False)
                    filtered = _filter_chunk(df_chunk, col_map)
                    if not filtered.empty:
                        rows_matched += len(filtered)
                        yield filtered
                except Exception as e:
                    print(f"  ⚠ Feil ved lesing av chunk ({rows_read} rader lest): {e}")
                buffer = [header_line]  # reset with header

        # Flush remaining lines
        if len(buffer) > 1:
            text = "\n".join(buffer)
            try:
                df_chunk = pd.read_csv(io.StringIO(text), sep=sep, dtype=str, low_memory=False)
                filtered = _filter_chunk(df_chunk, col_map)
                if not filtered.empty:
                    rows_matched += len(filtered)
                    yield filtered
            except Exception as e:
                print(f"  ⚠ Feil i siste chunk: {e}")

        print(f"  ℹ Leste {rows_read:,} rader totalt, matchet {rows_matched} for Utsira {SIM_YEAR}.")


def fetch_elhub_consumption():
    """
    Load Utsira consumption data from Elhub using streaming download.
    Falls back to verify=False on SSL errors.
    Returns a DataFrame or None (triggers SSB fallback).
    """
    if os.path.exists(ELHUB_CACHE):
        print("  ✓ Elhub cache funnet — laster inn...")
        with open(ELHUB_CACHE) as f:
            data = json.load(f)
        df = pd.DataFrame(data)
        # Handle both ISO strings and epoch-ms integers (legacy cache format)
        if df["startTime"].dtype == object:
            df["startTime"] = pd.to_datetime(df["startTime"], errors="coerce", utc=True).dt.tz_convert(None)
        else:
            df["startTime"] = pd.to_datetime(df["startTime"], unit="ms", errors="coerce")
        return df

    print("  ↓ Streamer Elhub-data (stor fil — filtrerer for Utsira underveis)...")
    print(f"    URL: {ELHUB_CSV_URL}")

    chunks = []

    for verify in (True, False):
        if not verify:
            print("  ⚠ SSL-feil. Prøver igjen uten sertifikatkontroll...")
        try:
            for df_chunk in _stream_elhub(verify_ssl=verify):
                chunks.append(df_chunk)
                print(f"    … {sum(len(c) for c in chunks)} rader hentet så langt", end="\r")
            break  # Success — no need to retry
        except requests.exceptions.SSLError:
            if verify:
                continue   # retry without SSL
            print("  ⚠ SSL-feil selv uten verifisering. Bruker SSB-estimater.")
            return None
        except requests.exceptions.HTTPError as e:
            print(f"  ⚠ HTTP-feil: {e}")
            return None
        except ValueError as e:
            # Column detection failed
            print(f"  ⚠ Kolonnedeteksjon feilet: {e}")
            return None
        except Exception as e:
            print(f"  ⚠ Nedlasting feilet: {e}")
            if verify:
                continue
            return None

    if not chunks:
        print(f"  ⚠ Ingen data funnet for kommune {UTSIRA_MUNICIPALITY_CODE}, år {SIM_YEAR}.")
        print("  ⚠ Bruker SSB-estimater.")
        return None

    df = pd.concat(chunks, ignore_index=True)
    print(f"\n  ✓ Elhub-data lastet: {len(df)} rader for Utsira {SIM_YEAR}.")
    df.to_json(ELHUB_CACHE, orient="records", date_format="iso")
    print(f"  ✓ Cachet til '{ELHUB_CACHE}'")
    return df


def elhub_to_hourly_loads(df, dti):
    """Convert Elhub DataFrame to hourly kW series per consumer group."""
    if df is None or df.empty:
        return None

    df = df.copy()
    df["startTime"] = pd.to_datetime(df["startTime"], errors="coerce")
    df["consumption_kWh"] = pd.to_numeric(df["consumption_kWh"], errors="coerce")
    df["consumerGroup"] = df["consumerGroup"].astype(str).str.strip().str.lower()
    df = df.dropna(subset=["startTime", "consumption_kWh"])

    print(f"  ℹ Elhub kolonner: {list(df.columns)}")
    print(f"  ℹ Forbruksgrupper: {sorted(df['consumerGroup'].unique())}")

    residential_groups = [
        "husholdning", "residential",
        "private",     # alternative Elhub label
    ]
    industry_groups = [
        "jordbruk", "industri", "næring", "offentlig",
        "agriculture", "industry", "business", "public",
        "commercial", "service", "tjenesteyting",
    ]

    mask_res = df["consumerGroup"].isin(residential_groups)
    mask_ind = df["consumerGroup"].isin(industry_groups)

    res   = df.loc[mask_res].groupby("startTime")["consumption_kWh"].sum()
    ind   = df.loc[mask_ind].groupby("startTime")["consumption_kWh"].sum()
    total = df.groupby("startTime")["consumption_kWh"].sum()

    results = {}
    if not res.empty:
        results["residential_kW"] = res.reindex(dti).fillna(0.0)
    if not ind.empty:
        results["industry_kW"] = ind.reindex(dti).fillna(0.0)
    results["total_kW"] = total.reindex(dti).fillna(0.0)

    print(
        f"  ✓ Elhub Utsira — snitt: {results['total_kW'].mean():.1f} kW"
        f" | år: {results['total_kW'].sum()/1e6:.3f} GWh"
    )
    return results


