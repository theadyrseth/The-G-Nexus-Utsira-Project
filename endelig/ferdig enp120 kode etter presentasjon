def main():
    print("\n" + "=" * 65)
    print("  G-Nexus Utsira — Hourly Energy Simulation")
    print("=" * 65)

    dti = pd.date_range(f"{SIM_YEAR}-01-01", periods=N_HOURS, freq="h")

    # ── Demand ────────────────────────────────────────────────────────────────
    print("\n[1/4] Building demand profiles...")
    elhub_df    = fetch_elhub_consumption()
    elhub_loads = elhub_to_hourly_loads(elhub_df, dti)

    if elhub_loads is None:
        raise RuntimeError(
            "\n\n  ✗ Elhub-data er ikkje tilgjengeleg.\n"
            "    Sjekk internettforbindelsen din og prøv igjen.\n"
            "    Viss problemet vedvarar kan Elhub-tenesta vera nede:\n"
            "    https://data.elhub.no\n"
        )

    print("  ✓ Using Elhub real consumption data for residential + business")
    res_kW = elhub_loads["residential_kW"]

    # Hypothetical loads from assignment spec — always use config parameters
    salmon_kW = pd.Series(build_salmon_load(dti), index=dti)
    water_kW  = build_water_sanitation_load(dti)

    ev_kW  = build_ev_load(dti)
    biz_kW = elhub_loads["industry_kW"]
    print("  ✓ Using Elhub business/industry data")
    dc_kW  = load_data_center(dti)

    demand_kW = res_kW + salmon_kW + water_kW + ev_kW + biz_kW + dc_kW
    loads_dict = {
        "Residential":    np.asarray(res_kW),
        "Salmon plant":   np.asarray(salmon_kW),
        "Water/sanitation": np.asarray(water_kW),
        "EV charging":    np.asarray(ev_kW),
        "Business":       np.asarray(biz_kW),
        "Data center":    np.asarray(dc_kW),
    }

    # ── Supply ────────────────────────────────────────────────────────────────
    print("[2/4] Fetching ERA5 weather & building generation profiles...")
    weather_df = fetch_era5_weather()
    wind_kW  = build_wind_generation(dti, weather_df)
    solar_kW = build_solar_generation(dti, weather_df)
    supply_kW = wind_kW + solar_kW

    # ── Battery ───────────────────────────────────────────────────────────────
    print("[3/4] Sizing battery & running dispatch...")
    battery_MWh, max_power_kW = get_battery_specs()
    net_kW = supply_kW.values - demand_kW.values
    soc_MWh, curtailed, deficit = simulate_battery(net_kW, battery_MWh, max_power_kW)
    bat_charge_kW = np.where(net_kW > 0, net_kW - curtailed, 0)

    # ── Summary ───────────────────────────────────────────────────────────────
    print("\n" + "─" * 65)
    print("  ANNUAL SUMMARY")
    print("─" * 65)
    for label, series in [
        ("Total demand",   demand_kW),
        ("  Residential",  res_kW),
        ("  Salmon plant", salmon_kW),
        ("  Water/sanit.", water_kW),
        ("  EV charging",  ev_kW),
        ("  Business",     biz_kW),
        ("  Data center",  dc_kW),
        ("Total supply",   supply_kW),
        ("  Wind",         wind_kW),
        ("  Solar",        solar_kW),
    ]:
        print(f"  {label:<22}: {np.asarray(series).sum()/1e6:7.2f} GWh")

    total_demand_MWh  = demand_kW.sum() / 1e3
    total_supply_MWh  = supply_kW.values.sum() / 1e3
    unmet_MWh         = deficit.sum() / 1e3
    served_MWh        = total_demand_MWh - unmet_MWh
    served_pct        = 100 * served_MWh / total_demand_MWh
    unmet_pct         = 100 * unmet_MWh  / total_demand_MWh
    renewable_frac    = 100 * total_supply_MWh / total_demand_MWh
    curt_MWh          = curtailed.sum() / 1e3

    print(f"  Battery              : {N_MEGAPACKS}× Tesla Megapack 2XL")
    print(f"  Battery capacity     : {battery_MWh:7.1f} MWh")
    print(f"  Battery max power    : {max_power_kW/1000:7.1f} MW")
    print(f"  Min SoC (floor)      : {MIN_BATTERY_SOC*100:.0f}%  "
          f"({MIN_BATTERY_SOC*battery_MWh:.1f} MWh unavailable)")
    print("─" * 65)
    print("  KEY PERFORMANCE INDICATORS")
    print("─" * 65)
    print(f"  {'Metric':<25}  {'Value':>15}")
    print(f"  {'─'*25}  {'─'*15}")
    print(f"  {'Total Load':<25}  {total_demand_MWh:>12.0f} MWh")
    print(f"  {'Served Load':<25}  {served_MWh:>12.0f} MWh")
    print(f"  {'Served Fraction':<25}  {served_pct:>14.2f}%")
    print(f"  {'Unmet Load':<25}  {unmet_MWh:>9.0f} MWh  ({unmet_pct:.2f}%)")
    print(f"  {'Renewable Fraction':<25}  {renewable_frac:>14.1f}%")
    print(f"  {'Curtailment':<25}  {curt_MWh:>12.0f} MWh")
    print(f"  {'Peak demand':<25}  {demand_kW.max()/1000:>13.2f} MW")
    print("─" * 65)

    if unmet_pct > 1.0:
        print("  ⚠  Unmet demand > 1%. Vurder fleire turbinar eller batteri.")
    else:
        print("  ✓  System dekkjer > 99% av etterspurnaden.")

    # ── Plots ─────────────────────────────────────────────────────────────────
    print("\n[4/4] Generating plots...")
    plot_monthly_production(dti, wind_kW, solar_kW, demand_kW)
    plot_signed_dispatch(dti, loads_dict, wind_kW, solar_kW,
                         soc_MWh, curtailed, deficit, battery_MWh, bat_charge_kW)
    plot_seasonal_weeks(dti, loads_dict, wind_kW, solar_kW,
                        soc_MWh, curtailed, deficit, bat_charge_kW, battery_MWh)

    rolling = pd.Series(supply_kW.values).rolling(48).sum()
    worst_start = dti[max(0, int(rolling.idxmin()) - 48)]

    plot_worst_case_week(dti, loads_dict, wind_kW, solar_kW,
                         soc_MWh, curtailed, deficit, bat_charge_kW, battery_MWh, worst_start)
    plot_annual_soc(dti, soc_MWh, battery_MWh, bat_charge_kW)
    plot_generation_profiles(dti, wind_kW, solar_kW)
    plot_pareto_frontier(demand_kW, weather_df, dti)
    plot_dunkelflaute_48h(demand_kW, loads_dict, battery_MWh, max_power_kW)

    print("\n  All done! Check the 'plots/' folder.\n")


if __name__ == "__main__":
    main()
