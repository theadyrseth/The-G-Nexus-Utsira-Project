def _week_panel(ax_s, ax_d, ax_soc, t, ld, w, s, bd, chg, cur, dfc, soc, bat_MWh, label):
    """Draw supply / demand / SoC panels for one week."""
    tot_dem = sum(ld.values())
    tot_sup = w + s + bd

    ax_s.stackplot(t, w / 1000, s / 1000, bd / 1000, cur / 1000,
                   labels=["Wind", "PV", "Battery discharge", "Curtailed"],
                   colors=[C["wind"], C["solar"], C["bat_dis"], C["curt_wind"]], alpha=0.85)
    ax_s.plot(t, tot_dem / 1000, "k--", lw=1.2, label="Total demand")
    if dfc.sum() > 0:
        ax_s.fill_between(t, tot_sup / 1000, tot_dem / 1000,
                          where=(tot_dem > tot_sup), color=C["unmet"], alpha=0.4, label="Unmet")
    ax_s.set_ylabel("Power (MW)")
    ax_s.set_title(f"Representative {label} Week", fontsize=9)
    ax_s.legend(fontsize=6, loc="upper right", ncol=2)
    ax_s.set_ylim(bottom=0)

    ax_d.stackplot(t,
                   ld.get("Residential", 0) / 1000,
                   ld.get("EV charging", 0) / 1000,
                   ld.get("Business", 0) / 1000,
                   (ld.get("Salmon plant", 0) + ld.get("Water/sanitation", 0)) / 1000,
                   ld.get("Data center", 0) * 0.55 / 1000,
                   ld.get("Data center", 0) * 0.45 / 1000,
                   chg / 1000,
                   labels=["Private", "EV", "Business", "Industry", "DC IT", "DC cooling", "Bat chg"],
                   colors=[C["private"], C["ev"], C["business"], C["industry"],
                           C["dc_it"], C["dc_cool"], C["bat_chg"]], alpha=0.85)
    ax_d.plot(t, tot_dem / 1000, "k--", lw=1, label="Total demand")
    ax_d.set_ylabel("Power (MW)")
    ax_d.legend(fontsize=6, loc="upper right", ncol=3)
    ax_d.set_ylim(bottom=0)

    soc_pct = soc / bat_MWh * 100
    ax_soc.fill_between(t, soc_pct, color="#a5d6a7", alpha=0.7)
    ax_soc.plot(t, soc_pct, color="green", lw=1, label="SoC (%)")
    ax_soc.axhline(100, color="red", ls="--", lw=0.8, label="Full")
    ax_soc.axhline(20, color="orange", ls="--", lw=0.8, label="Min 20%")
    ax_soc.set_ylim(0, 110)
