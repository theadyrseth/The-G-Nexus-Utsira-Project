def wind_power_curve(v_ms):
    """Vestas V90-2.0 MW power curve × N_WIND_TURBINES, returns kW."""
    scale = N_WIND_TURBINES
    curve_kW = np.array(VESTAS_V90_KW) * scale
    return np.clip(
        np.interp(np.asarray(v_ms, float), VESTAS_V90_MS, curve_kW),
        0,
        WIND_INSTALLED_MW * 1000,
    )


def pv_power(irr_Wm2, temp_C, PR=0.80, gamma=-0.0026):
    """IEC 61724 PV model."""
    G = np.asarray(irr_Wm2, float)
    T_cell = np.asarray(temp_C, float) + 25.0
    P_kW = SOLAR_INSTALLED_MW * 1000
    return np.clip(P_kW * (G / 1000) * PR * (1 + gamma * (T_cell - 25)), 0, P_kW)


def build_wind_generation(dti, weather_df):
    """Hourly wind kW — ERA5 power curve via Vestas V90 datasheet."""
    if weather_df is None:
        raise RuntimeError(
            "\n\n  ✗ ERA5 vinddata er ikkje tilgjengeleg.\n"
            "    Sjekk internettforbindelsen din og prøv igjen.\n"
            "    Viss problemet vedvarar kan Open-Meteo vera nede:\n"
            "    https://open-meteo.com\n"
        )
    kW = wind_power_curve(weather_df["wind_100m"].values)
    print(f"  ✓ ERA5 wind CF: {kW.mean() / (WIND_INSTALLED_MW * 1000):.3f}")
    return pd.Series(kW, index=dti)


def build_solar_generation(dti, weather_df):
    """Hourly solar PV kW — ERA5 irradiance via IEC 61724 model."""
    if weather_df is None:
        raise RuntimeError(
            "\n\n  ✗ ERA5 soldata er ikkje tilgjengeleg.\n"
            "    Sjekk internettforbindelsen din og prøv igjen.\n"
            "    Viss problemet vedvarar kan Open-Meteo vera nede:\n"
            "    https://open-meteo.com\n"
        )
    kW = pv_power(weather_df["irradiance"].values, weather_df["temp_2m"].values)
    print(
        f"  ✓ ERA5 solar CF: {kW.mean() / (SOLAR_INSTALLED_MW * 1000):.3f}  "
        f"({kW.sum()/1e6:.3f} GWh/yr)"
    )
    return pd.Series(kW, index=dti)


