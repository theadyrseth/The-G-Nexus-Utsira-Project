    ax.set_xlim(t[0], t[-1])


def _get_period_data(dti, loads_dict, wind_kW, solar_kW,
                     soc_MWh, curtailed, deficit, bat_charge_kW, start, days):
    """Slice all arrays to a given number of days starting at `start`."""
    mask = (dti >= start) & (dti < start + pd.Timedelta(days=days))
    t = dti[mask]
    ld = {k: v[mask] for k, v in loads_dict.items()}
    w = np.asarray(wind_kW)[mask]
    s = np.asarray(solar_kW)[mask]
    soc = soc_MWh[mask]
    cur = curtailed[mask]
    dfc = deficit[mask]
    chg = bat_charge_kW[mask]
    bd = np.clip(sum(v for v in ld.values()) - w - s, 0, None)
    return t, ld, w, s, bd, chg, cur, dfc, soc


def plot_seasonal_weeks(dti, loads_dict, wind_kW, solar_kW,
